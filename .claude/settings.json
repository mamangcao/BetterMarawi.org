{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git restore:*)",
      "Bash(git checkout -- :*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}